{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Flask Job Portal",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Running on (http://127\\.0\\.0\\.1:5000)"
      },
      "env": {
        "FLASK_APP": "app.py",
        "FLASK_DEBUG": "1"
      },
      "justMyCode": true
    }
  ]
}
